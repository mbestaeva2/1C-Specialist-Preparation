
Процедура ОбработкаПроведения(Отказ, Режим)
	
	
	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	Движения.ОстаткиНоменклатуры.Записать();
	
	Движения.РаспределениеВыручки.Записывать = Истина;
	Движения.ВзаимоРасчетыСКомитентами.Записывать = Истина;
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = СписокНоменклатуры;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Договор", "ДоговорКомиссии");
	Блокировка.Заблокировать();
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасходнаяНакладнаяСписокНоменклатуры.Номенклатура КАК Номенклатура,
	|	РасходнаяНакладнаяСписокНоменклатуры.ДоговорКомиссии КАК ДоговорКомиссии,
	|	СУММА(РасходнаяНакладнаяСписокНоменклатуры.Количество) КАК КоличествоДок,
	|	СУММА(РасходнаяНакладнаяСписокНоменклатуры.Сумма) КАК СуммаДок
	|ПОМЕСТИТЬ Вт_Тч
	|ИЗ
	|	Документ.РасходнаяНакладная.СписокНоменклатуры КАК РасходнаяНакладнаяСписокНоменклатуры
	|ГДЕ
	|	РасходнаяНакладнаяСписокНоменклатуры.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РасходнаяНакладнаяСписокНоменклатуры.Номенклатура,
	|	РасходнаяНакладнаяСписокНоменклатуры.ДоговорКомиссии
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	ДоговорКомиссии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт_Тч.Номенклатура КАК Номенклатура,
	|	Вт_Тч.ДоговорКомиссии КАК ДоговорКомиссии,
	|	Вт_Тч.КоличествоДок КАК КоличествоДок,
	|	Вт_Тч.СуммаДок КАК СуммаДок,
	|	Вт_Тч.Номенклатура.Представление КАК НоменклатураПредставление,
	|	Вт_Тч.ДоговорКомиссии.Представление КАК ДоговорКомиссииПредставление,
	|	ЕСТЬNULL(ОстаткиНоменклатурыОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ОстаткиНоменклатурыОстатки.СуммаОстаток, 0) КАК СуммаОстаток,
	|	Вт_Тч.ДоговорКомиссии.ПроцентКомисии КАК ПроцентКомисии
	|ИЗ
	|	Вт_Тч КАК Вт_Тч
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиНоменклатуры.Остатки(
	|				&МоментВремени,
	|				(Номенклатура, Договор) В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Вт_Тч.Номенклатура КАК Номенклатура,
	|						Вт_Тч.ДоговорКомиссии КАК ДоговорКомиссии
	|					ИЗ
	|						Вт_Тч КАК Вт_Тч)) КАК ОстаткиНоменклатурыОстатки
	|		ПО Вт_Тч.Номенклатура = ОстаткиНоменклатурыОстатки.Номенклатура
	|			И Вт_Тч.ДоговорКомиссии = ОстаткиНоменклатурыОстатки.Договор";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.КоличествоОстаток < ВыборкаДетальныеЗаписи.КоличествоДок  Тогда
			
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Не хватает товара %1 по договору %2 доступное количество %3 шт.", 
			ВыборкаДетальныеЗаписи.НоменклатураПредставление,
			ВыборкаДетальныеЗаписи.ДоговорКомиссииПредставление,
			ВыборкаДетальныеЗаписи.КоличествоОстаток);
			
			Сообщение.Сообщить();
			
		КонецЕсли;
		Если Отказ Тогда 
			Продолжить;
		КонецЕсли;
		
		
		Движение = Движения.ОстаткиНоменклатуры.Добавить();
		// регистр ОстаткиНоменклатуры Расход
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Договор = ВыборкаДетальныеЗаписи.ДоговорКомиссии;
		Движение.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
		Движение.Количество =Мин(ВыборкаДетальныеЗаписи.КоличествоДок, ВыборкаДетальныеЗаписи.КоличествоОстаток);
		Если Движение.Количество = ВыборкаДетальныеЗаписи.КоличествоОстаток Тогда 
			Себестоимость = ВыборкаДетальныеЗаписи.СуммаОстаток;
		Иначе
			Себестоимость = Окр(Движение.Количество / ВыборкаДетальныеЗаписи.КоличествоОстаток * ВыборкаДетальныеЗаписи.СуммаОстаток);
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.СуммаДок < Себестоимость Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Сумма продажи товара %1 по  %2, ниже Себестоимости %3", Движение.Номенклатура, Движение.Договор,
			Себестоимость);
			
			Сообщение.Сообщить();
			
		КонецЕсли;
		Движение.Сумма = Себестоимость;
		Движение.ХозяйственнаяОперация = Перечисления.ХозяиственнаяОперация.ДолгПередКомитентом;
		
		
		// Регистр РаспределениеВыручки
		Движение = Движения.РаспределениеВыручки.Добавить();
		Движение.Период = Дата;
		Движение.Менеджер = Менеджер;
		Движение.Договор = ВыборкаДетальныеЗаписи.ДоговорКомиссии;
		Движение.СуммаПродаж = ВыборкаДетальныеЗаписи.СуммаДок;
		Движение.ВыплатаКомитенту = ВыборкаДетальныеЗаписи.ПроцентКомисии * Движение.СуммаПродаж / 100;
		Движение.ВыплатаСебе = Движение.СуммаПродаж - Движение.ВыплатаКомитенту;
		
		Движение = Движения.ВзаимоРасчетыСКомитентами.Добавить();
		// регистр ВзаимоРасчетыСКомитентами Приход
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Договор = ВыборкаДетальныеЗаписи.ДоговорКомиссии;
		Движение.Товар = ВыборкаДетальныеЗаписи.Номенклатура;
		Движение.Количество = ВыборкаДетальныеЗаписи.КоличествоДок;
		Движение.СуммаПродаж = ВыборкаДетальныеЗаписи.СуммаДок;
		Движение.СуммаВыплатыКомитенту = ВыборкаДетальныеЗаписи.ПроцентКомисии * Движение.СуммаПродаж / 100;
		Движение.ХозяйственнаяОперация = Перечисления.ХозяиственнаяОперация.ДолгПередКомитентом;
		
		
	КонецЦикла;
	
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
КонецПроцедуры
