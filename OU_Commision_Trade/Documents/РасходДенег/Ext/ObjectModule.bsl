
Процедура ОбработкаПроведения(Отказ, Режим)
	
	
	// регистр ВзаимоРасчетыСКомитентами Расход
	Движения.ВзаимоРасчетыСКомитентами.Записывать = Истина;
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасходДенегСписокНоменклатуры.Номенклатура КАК Номенклатура,
	|	РасходДенегСписокНоменклатуры.ДоговорКомиссии КАК ДоговорКомиссии,
	|	СУММА(РасходДенегСписокНоменклатуры.Количество) КАК Количество,
	|	СУММА(РасходДенегСписокНоменклатуры.Сумма) КАК Сумма,
	|	СУММА(РасходДенегСписокНоменклатуры.СуммаВыплаты) КАК СуммаВыплаты
	|ИЗ
	|	Документ.РасходДенег.СписокНоменклатуры КАК РасходДенегСписокНоменклатуры
	|ГДЕ
	|	РасходДенегСписокНоменклатуры.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РасходДенегСписокНоменклатуры.Номенклатура,
	|	РасходДенегСписокНоменклатуры.ДоговорКомиссии";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Движение = Движения.ВзаимоРасчетыСКомитентами.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Договор = ВыборкаДетальныеЗаписи.ДоговорКомиссии;
		Движение.Товар = ВыборкаДетальныеЗаписи.Номенклатура;
		Движение.Количество = ВыборкаДетальныеЗаписи.Количество;
		Движение.СуммаПродаж = ВыборкаДетальныеЗаписи.Сумма;
		Движение.СуммаВыплатыКомитенту = ВыборкаДетальныеЗаписи.СуммаВыплаты;
		Движение.ХозяйственнаяОперация = Перечисления.ХозяиственнаяОперация.Отчитались;
	КонецЦикла;
	
	Движения.ВзаимоРасчетыСКомитентами.БлокироватьДляИзменения = Истина;
	Движения.Записать();
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВзаимоРасчетыСКомитентамиОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ВзаимоРасчетыСКомитентамиОстатки.Товар КАК Товар,
	|	ВзаимоРасчетыСКомитентамиОстатки.СуммаПродажОстаток КАК СуммаПродажОстаток,
	|	ВзаимоРасчетыСКомитентамиОстатки.СуммаВыплатыКомитентуОстаток КАК СуммаВыплатыКомитентуОстаток,
	|	ВзаимоРасчетыСКомитентамиОстатки.Товар.Представление КАК ТоварПредставление,
	|	ВзаимоРасчетыСКомитентамиОстатки.Договор.Представление КАК ДоговорПредставление
	|ИЗ
	|	РегистрНакопления.ВзаимоРасчетыСКомитентами.Остатки(
	|			&Граница,
	|			Товар В (&Номенклатура)
	|				И Договор В (&Договор)) КАК ВзаимоРасчетыСКомитентамиОстатки
	|ГДЕ
	|	(ВзаимоРасчетыСКомитентамиОстатки.КоличествоОстаток < 0
	|			ИЛИ ВзаимоРасчетыСКомитентамиОстатки.СуммаПродажОстаток < 0
	|			ИЛИ ВзаимоРасчетыСКомитентамиОстатки.СуммаВыплатыКомитентуОстаток < 0)";
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени()));
	Запрос.УстановитьПараметр("Договор", СписокНоменклатуры.ВыгрузитьКолонку("ДоговорКомиссии"));
	Запрос.УстановитьПараметр("Номенклатура",СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("Превышен остаток по товару %1 По договору %2, доступное количество %3",
		ВыборкаДетальныеЗаписи.ТоварПредставление,
		ВыборкаДетальныеЗаписи.ДоговорПредставление,
		-ВыборкаДетальныеЗаписи.КоличествоОстаток);
		Сообщение.Сообщить();
	КонецЦикла;
	
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
КонецПроцедуры
