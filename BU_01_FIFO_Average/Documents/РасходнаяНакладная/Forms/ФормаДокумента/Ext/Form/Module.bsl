&НаКлиенте
Процедура СписокНоменклатурыСрокГодностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтрокаТЧ = Элементы.СписокНоменклатуры.ТекущиеДанные;
	Если СтрокаТЧ = Неопределено Или  Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
	
		Возврат;
		
	
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	СписокСроков = СписокДоступныхСроковНаСервере(СтрокаТЧ.Номенклатура, Объект.Дата);
	
	Если СписокСроков.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"По выбранному товару нет остатков по сроку годности!");
		Возврат;

	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораСрокаГодности", ЭтотОбъект);
	ПоказатьВыборИзСписка(ОписаниеОповещения, СписокСроков, Элемент);
	 КонецПроцедуры
	
	&НаКлиенте
	Процедура ПослеВыбораСрокаГодности(ВыбранныйЭлемент, ДополнительныйеПараметры)Экспорт 
			
		Если ВыбранныйЭлемент <> Неопределено Тогда
			СтрокаТЧ = Элементы.СписокНоменклатуры.ТекущиеДанные;
			Если СтрокаТЧ <> Неопределено Тогда
			
			СтрокаТЧ.СрокГодности  = ВыбранныйЭлемент.Значение;	
			
			КонецЕсли;
			
			
		
		КонецЕсли;
	

	КонецПроцедуры
&НаСервереБезКонтекста
Функция СписокДоступныхСроковНаСервере(Номенклатура, ДатаДокумента)

СписокСроков = Новый СписокЗначений;

	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УправленческийОстатки.Субконто2 КАК СрокГодности,
		|	УправленческийОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрБухгалтерии.Управленческий.Остатки(&Период, &Счет = &Счет, &МассивСубконто, Субконто1 = &Номенклатура) КАК УправленческийОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	Субконто2";
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.СрокГодности);
	Запрос.УстановитьПараметр("МассивСубконто", МассивСубконто);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Период", ?(ЗначениеЗаполнено(ДатаДокумента),ДатаДокумента,ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Представление = Формат(ВыборкаДетальныеЗаписи.СрокГодности,"ДФ=dd.MM.yyyy") + " (ост. " + ВыборкаДетальныеЗаписи.КоличествоОстаток + "Шт.)";
		
		СписокСроков.Добавить(ВыборкаДетальныеЗаписи.СрокГодности, Представление);
	КонецЦикла;
	Возврат СписокСроков;
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА


КонецФункции // ()
 
	
